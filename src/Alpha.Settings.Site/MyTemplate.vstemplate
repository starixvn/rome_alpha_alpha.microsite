<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>Alpha Microsite Site Template</Name>
    <Description>Alpha.Settings.Site Project</Description>
    <ProjectType>CSharp</ProjectType>
    <ProjectSubType>
    </ProjectSubType>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>Alpha.Settings.Site</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.ico</Icon>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="Alpha.Settings.Site.csproj" File="Alpha.Settings.Site.csproj" ReplaceParameters="true">
      <Folder Name="App_Data" TargetFolderName="App_Data">
        <ProjectItem ReplaceParameters="true" TargetFileName="AuthorizationSection.config">AuthorizationSection.config</ProjectItem>
        <Folder Name="SPNames" TargetFolderName="SPNames">
          <ProjectItem ReplaceParameters="true" TargetFileName="DBAGE.bodb02.BODBDownlineNet.xml">DBAGE.bodb02.BODBDownlineNet.xml</ProjectItem>
          <ProjectItem ReplaceParameters="false" TargetFileName="DBARC.bodb_Archive.BODBDownlineNet">DBARC.bodb_Archive.BODBDownlineNet</ProjectItem>
          <ProjectItem ReplaceParameters="true" TargetFileName="DBONUSER.ON_USER.BODBDownlineNet.xml">DBONUSER.ON_USER.BODBDownlineNet.xml</ProjectItem>
        </Folder>
      </Folder>
      <Folder Name="App_Start" TargetFolderName="App_Start">
        <ProjectItem ReplaceParameters="true" TargetFileName="DependencyConfig.cs">DependencyConfig.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="RouteConfig.cs">RouteConfig.cs</ProjectItem>
      </Folder>
      <Folder Name="assets" TargetFolderName="assets">
        <Folder Name="bundles" TargetFolderName="bundles">
        </Folder>
        <Folder Name="scripts" TargetFolderName="scripts" />
        <Folder Name="styles" TargetFolderName="styles">
          <ProjectItem ReplaceParameters="false" TargetFileName="_variables.scss">_variables.scss</ProjectItem>
          <Folder Name="images" TargetFolderName="images">
            <ProjectItem ReplaceParameters="false" TargetFileName="1F.gif">1F.gif</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="1L.gif">1L.gif</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="firstGoal.gif">firstGoal.gif</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="green-star.gif">green-star.gif</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="lastGoal.gif">lastGoal.gif</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="note_title.gif">note_title.gif</ProjectItem>
          </Folder>
          <ProjectItem ReplaceParameters="false" TargetFileName="site.scss">site.scss</ProjectItem>
        </Folder>
      </Folder>
      <Folder Name="Controllers" TargetFolderName="Controllers">
        <ProjectItem ReplaceParameters="true" TargetFileName="HomeController.cs">HomeController.cs</ProjectItem>
        <ProjectItem ReplaceParameters="true" TargetFileName="SiteBaseController.cs">SiteBaseController.cs</ProjectItem>
      </Folder>
	  <ProjectItem ReplaceParameters="true" TargetFileName="bundleconfig.json">bundleconfig.json</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="compilerconfig.json">compilerconfig.json</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="compilerconfig.json.defaults">compilerconfig.json.defaults</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="deployment.ignore">deployment.ignore</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Global.asax">Global.asax</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Global.asax.cs">Global.asax.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="GlobalSuppressions.cs">GlobalSuppressions.cs</ProjectItem>
      <Folder Name="Models" TargetFolderName="Models">
        <ProjectItem ReplaceParameters="true" TargetFileName="User.cs">User.cs</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="true" TargetFileName="packages.config">packages.config</ProjectItem>
      <Folder Name="Properties" TargetFolderName="Properties">
        <ProjectItem ReplaceParameters="true" TargetFileName="AssemblyInfo.cs">AssemblyInfo.cs</ProjectItem>
      </Folder>
      <Folder Name="Views" TargetFolderName="Views">
        <ProjectItem ReplaceParameters="true" TargetFileName="_ViewStart.cshtml">_ViewStart.cshtml</ProjectItem>
        <Folder Name="Home" TargetFolderName="Home" />
        <Folder Name="Shared" TargetFolderName="Shared">
          <ProjectItem ReplaceParameters="true" TargetFileName="_Layout.cshtml">_Layout.cshtml</ProjectItem>
