      <ProjectItem ReplaceParameters="true" TargetFileName="Web.backupMNLNap.config">Web.backupMNLNap.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.backupMNLNap2.config">Web.backupMNLNap2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.backupMNLNap4.config">Web.backupMNLNap4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.napexternal.config">Web.napexternal.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.napexternal2.config">Web.napexternal2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.napexternal4.config">Web.napexternal4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.napinternal.config">Web.napinternal.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.napinternal2.config">Web.napinternal2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.napinternal4.config">Web.napinternal4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.pro.config">Web.pro.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.pro2.config">Web.pro2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.pro4.config">Web.pro4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.sit.config">Web.sit.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.sit2.config">Web.sit2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.sit4.config">Web.sit4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.uat.config">Web.uat.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.uat2.config">Web.uat2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.uat4.config">Web.uat4.config</ProjectItem>
