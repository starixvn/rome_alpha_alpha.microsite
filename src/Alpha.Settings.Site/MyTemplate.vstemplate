        </Folder>
        <ProjectItem ReplaceParameters="true" TargetFileName="web.config">web.config</ProjectItem>
      </Folder>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.config">Web.AppSettings.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.backupMNL.config">Web.AppSettings.backupMNL.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.backupMNL2.config">Web.AppSettings.backupMNL2.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.backupMNL4.config">Web.AppSettings.backupMNL4.config</ProjectItem>
