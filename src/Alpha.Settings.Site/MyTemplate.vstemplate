      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.napexternal4.config">Web.AppSettings.napexternal4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.napinternal.config">Web.AppSettings.napinternal.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.napinternal2.config">Web.AppSettings.napinternal2.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.napinternal4.config">Web.AppSettings.napinternal4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.pro.config">Web.AppSettings.pro.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.pro2.config">Web.AppSettings.pro2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.pro4.config">Web.AppSettings.pro4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.sit.config">Web.AppSettings.sit.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.sit2.config">Web.AppSettings.sit2.config</ProjectItem>
	  <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.sit4.config">Web.AppSettings.sit4.config</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="Web.AppSettings.uat.config">Web.AppSettings.uat.config</ProjectItem>
